# ==============================================================================
# NuvaMed Production & Local Development Environment Variables
# ==============================================================================
# Copy this file to .env.local for local development:
# cp .env.example .env.local
# DO NOT COMMIT REAL SECRETS OR PRIVATE KEYS TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# SHELBY PROTOCOL NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
# Target Shelby Network ("testnet" | "mainnet")
NEXT_PUBLIC_SHELBY_NETWORK=testnet

# Public RPC endpoint for Shelby Storage Providers and Placement Groups
NEXT_PUBLIC_SHELBY_RPC_URL=https://rpc.shelby.xyz

# Default Shelby namespace address for contract placement groups
NEXT_PUBLIC_SHELBY_NAMESPACE_ADDRESS=0x1234567890abcdef1234567890abcdef12345678

# ------------------------------------------------------------------------------
# APTOS L1 BLOCKCHAIN CONFIGURATION
# ------------------------------------------------------------------------------
# Aptos L1 node REST API URL (Testnet / Mainnet)
NEXT_PUBLIC_APTOS_NODE_URL=https://fullnode.testnet.aptoslabs.com/v1

# Aptos Chain ID (1 = Mainnet, 2 = Testnet, 143 = Localnet)
NEXT_PUBLIC_APTOS_CHAIN_ID=2

# ------------------------------------------------------------------------------
# WEB3 WALLET CONNECTIVITY (RAINBOWKIT & WAGMI)
# ------------------------------------------------------------------------------
# Reown / WalletConnect Project ID (Obtain from https://cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=3a8170812b534d0ff9d794f19a901d64

# ------------------------------------------------------------------------------
# DOUBLEZERO FIBER NETWORK PERFORMANCE SLAs
# ------------------------------------------------------------------------------
# Maximum acceptable latency threshold SLA in milliseconds
NEXT_PUBLIC_DOUBLEZERO_LATENCY_SLA_MS=1.4

# Per-MB USDC Micropayment rate for AI dataset streaming ($0.005/MB)
NEXT_PUBLIC_MICROPAYMENT_RATE_PER_MB=0.005
